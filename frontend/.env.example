# Copy to frontend/.env. Ask the project owner for DEVELOPMENT configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_RECAPTCHA_SITE_KEY=
# Never put service-role keys, SMTP passwords or payment secrets in VITE_ variables.
