# Server-only invoice email settings. Copy to .env in the repository root.
# Generate a NEW Gmail app password; never commit actual credentials.
EMAIL_USER=
EMAIL_PASS=

# GHN server gateway only. Never use VITE_ for these credentials.
# Leave disabled until the previously exposed token has been rotated.
GHN_ENABLED=false
GHN_TOKEN=
GHN_SHOP_ID=
# Dedicated shipping-sync capability. Generated locally by npm run ghn:prepare --workspace=backend.
# Never use a Supabase admin key here; never prefix this value with VITE_.
GHN_SYNC_SECRET=
SUPABASE_URL=https://vucrgwryaerhphparchc.supabase.co
SUPABASE_ANON_KEY=
GHN_FROM_NAME=Curve & Confidence
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=
GHN_FROM_WARD=
GHN_FROM_DISTRICT=
GHN_FROM_PROVINCE=

# Server-only VNPay configuration. Never use VITE_ for the signing secret.
VNPAY_HASH_SECRET=
VNPAY_TMN_CODE=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
APP_ORIGIN=https://thoi-trang-big-size.vercel.app
